				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "adls_hindi47",
								"type": "DatasetReference"
							},
							"name": "dataflowAdlshindi47",
							"description": "Import data from adls_hindi47"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "adls_hindi47",
								"type": "DatasetReference"
							},
							"name": "sinkHindi47",
							"description": "Export data to sql_hindi47"
						}
					],
					"transformations": [
						{
							"name": "filterNewRecordshindi",
							"description": "Filtering rows using expressions on columns 'ingested_at_utc'"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_last_ingested_time_hindi as string",
						"}",
						"source(output(",
						"          name as string,",
						"          email_address as string,",
						"          mobile as string,",
						"          city as string,",
						"          age as long,",
						"          registration_date as string,",
						"          workshop_date as string,",
						"          amount as double,",
						"          utm_source as string,",
						"          utm_medium as string,",
						"          utm_campaign as string,",
						"          utm_content as string,",
						"          source_workbook as string,",
						"          source_spreadsheet as string,",
						"          source_sheet as string,",
						"          source_row as long,",
						"          record_id as string,",
						"          row_hash as string,",
						"          ingested_at_utc as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> dataflowAdlshindi47",
						"dataflowAdlshindi47 filter(toTimestamp(ingested_at_utc, 'yyyy-MM-dd HH:mm:ss.SSSSSS') > toTimestamp($p_last_ingested_time_hindi, 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSSSSS')) ~> filterNewRecordshindi",
						"filterNewRecordshindi sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          name as string,",
						"          email_address as string,",
						"          mobile as string,",
						"          city as string,",
						"          age as long,",
						"          registration_date as string,",
						"          workshop_date as string,",
						"          amount as double,",
						"          utm_source as string,",
						"          utm_medium as string,",
						"          utm_campaign as string,",
						"          utm_content as string,",
						"          source_workbook as string,",
						"          source_spreadsheet as string,",
						"          source_sheet as string,",
						"          source_row as long,",
						"          record_id as string,",
						"          row_hash as string,",
						"          ingested_at_utc as string",
						"     ),",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkHindi47"
					]
				}
			},
			"dependsOn": []
		},
