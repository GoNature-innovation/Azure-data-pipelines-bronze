{
	"name": "DF_English47_Incremental",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "adls_english47",
						"type": "DatasetReference"
					},
					"name": "dataflowAdlsEnglish47"
				},
				{
					"dataset": {
						"referenceName": "adls_hindi47",
						"type": "DatasetReference"
					},
					"name": "dataflowAdlshindi47"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_english47",
						"type": "DatasetReference"
					},
					"name": "sinkEnglish47"
				},
				{
					"dataset": {
						"referenceName": "sql_hindi47",
						"type": "DatasetReference"
					},
					"name": "sinkHindi47",
					"description": "Export data to sql_hindi47"
				}
			],
			"transformations": [
				{
					"name": "filterNewRecords"
				},
				{
					"name": "filterNewRecordsHindi"
				}
			],
			"scriptLines": [
				"parameters{",
				"     p_last_ingested_time as string",
				"}",
				"source(output(",
				"          name as string,",
				"          email_address as string,",
				"          mobile as string,",
				"          city as string,",
				"          age as long,",
				"          registration_date as string,",
				"          workshop_date as string,",
				"          amount as double,",
				"          utm_source as string,",
				"          utm_medium as string,",
				"          utm_campaign as string,",
				"          utm_content as string,",
				"          source_workbook as string,",
				"          source_spreadsheet as string,",
				"          source_sheet as string,",
				"          source_row as long,",
				"          record_id as string,",
				"          row_hash as string,",
				"          ingested_at_utc as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> dataflowAdlsEnglish47",
				"source(output(",
				"          name as string,",
				"          email_address as string,",
				"          mobile as string,",
				"          city as string,",
				"          age as long,",
				"          registration_date as string,",
				"          workshop_date as string,",
				"          amount as double,",
				"          utm_source as string,",
				"          utm_medium as string,",
				"          utm_campaign as string,",
				"          utm_content as string,",
				"          source_workbook as string,",
				"          source_spreadsheet as string,",
				"          source_sheet as string,",
				"          source_row as long,",
				"          record_id as string,",
				"          row_hash as string,",
				"          ingested_at_utc as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> dataflowAdlshindi47",
				"dataflowAdlsEnglish47 filter(toTimestamp(ingested_at_utc, 'yyyy-MM-dd HH:mm:ss.SSSSSS') > toTimestamp($p_last_ingested_time, 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSSSSS')) ~> filterNewRecords",
				"dataflowAdlshindi47 filter(toTimestamp(ingested_at_utc, 'yyyy-MM-dd HH:mm:ss.SSSSSS') >",
				"toTimestamp($p_last_ingested_time, 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSSSSS')) ~> filterNewRecordsHindi",
				"filterNewRecords sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          name as string,",
				"          email_address as string,",
				"          mobile as string,",
				"          city as string,",
				"          age as long,",
				"          registration_date as timestamp,",
				"          workshop_date as string,",
				"          amount as decimal(10,2),",
				"          utm_source as string,",
				"          utm_medium as string,",
				"          utm_campaign as string,",
				"          utm_content as string,",
				"          source_workbook as string,",
				"          source_spreadsheet as string,",
				"          source_sheet as string,",
				"          source_row as integer,",
				"          record_id as string,",
				"          row_hash as string,",
				"          ingested_at_utc as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkEnglish47",
				"filterNewRecordsHindi sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          name as string,",
				"          email_address as string,",
				"          mobile as string,",
				"          city as string,",
				"          age as long,",
				"          registration_date as timestamp,",
				"          workshop_date as string,",
				"          amount as decimal(10,2),",
				"          utm_source as string,",
				"          utm_medium as string,",
				"          utm_campaign as string,",
				"          utm_content as string,",
				"          source_workbook as string,",
				"          source_spreadsheet as string,",
				"          source_sheet as string,",
				"          source_row as integer,",
				"          record_id as string,",
				"          row_hash as string,",
				"          ingested_at_utc as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkHindi47"
			]
		}
	}
}